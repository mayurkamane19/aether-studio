# AETHER STUDIO — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Do NOT commit actual secrets or credentials to source control.

# ------------------------------------------------------------------------------
# 1. DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://aetherstudio.com

# ------------------------------------------------------------------------------
# 2. EMAIL SERVICE PROVIDER (Resend Integration)
# ------------------------------------------------------------------------------
# API Key generated at https://resend.com/api-keys
RESEND_API_KEY=re_your_actual_key_here

# Destination Email Address where lead notifications will be delivered
CONTACT_DESTINATION_EMAIL=your_destination_email@example.com

# Sender Address (Use onboarding@resend.dev for testing or your verified domain sender)
CONTACT_FROM_EMAIL=Aether Studio Leads <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 3. DATABASE / CRM PERSISTENCE (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_password@db.your_supabase_project.supabase.co:5432/postgres
ADMIN_CRM_TOKEN=your_secure_admin_secret_token_here

# ------------------------------------------------------------------------------
# 4. CALENDAR / BOOKING INTEGRATION (Cal.com / Google Calendar)
# ------------------------------------------------------------------------------
CAL_COM_API_KEY=cal_live_your_api_key_here
CAL_COM_EVENT_TYPE_ID=123456
